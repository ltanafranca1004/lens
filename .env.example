# Lens environment configuration.
# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by the backend and Alembic.
# Format: postgresql://USER[:PASSWORD]@HOST[:PORT]/DBNAME
# In production this is the Supabase Session-mode pooler string (IPv4), e.g.
# postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://user@localhost/lens

# Secret used to sign and verify JWT auth tokens (HS256).
# Generate a strong value with: openssl rand -hex 32
JWT_SECRET=

# Groq API key, used when USE_MOCK_LLM=false.
# Create one at https://console.groq.com/keys
GROQ_API_KEY=

# When true, the LLM layer returns canned mock responses (no API calls).
# Set to false to call the real Groq API.
USE_MOCK_LLM=true

# Comma-separated list of allowed browser origins for CORS.
# Local dev default is http://localhost:5173; in production set to the Vercel URL.
# "*" is refused at startup; Vercel preview URLs are intentionally not allowed.
CORS_ORIGINS=http://localhost:5173

# Serve the interactive API docs (/docs, /redoc, /openapi.json). Off by default and in production;
# set to true for local dev.
# ENABLE_API_DOCS=false

# --- Abuse and cost limits (all optional; defaults shown) -----------------------------------

# Per-scope request rate limits: comma-separated "count/unit" windows (second|minute|hour|day);
# every window must pass. Per-user scopes are keyed by user ID, login/register by client IP.
# In-memory for v1, so counts reset when the server restarts or Render spins down.
# RATE_LIMIT_LOGIN=20/minute,100/hour
# RATE_LIMIT_REGISTER=20/hour,50/day
# RATE_LIMIT_CREATE_SESSION=3/hour,5/day
# RATE_LIMIT_RESUME=5/hour,10/day
# RATE_LIMIT_GENERATE=3/hour,5/day
# RATE_LIMIT_ANSWER=10/minute,30/hour,40/day
# RATE_LIMIT_COMPLETE=10/hour

# Client IP behind Render's proxy. Production MUST set CLIENT_IP_HEADER=cf-connecting-ip
# (verified; see docs/specs/security-pass.md). If unset (local dev), the X-Forwarded-For entry
# TRUSTED_PROXY_COUNT positions from the right is used. The leftmost X-Forwarded-For entry and
# the socket peer are never used; unresolvable callers share one "unknown" bucket.
# CLIENT_IP_HEADER=
# TRUSTED_PROXY_COUNT=1

# Global daily Groq circuit breaker (Postgres table groq_daily_usage, one row per UTC day).
# Defaults are 90% of Groq's free tier for openai/gpt-oss-120b (1,000 requests / 200,000 tokens per day).
# GROQ_DAILY_CALL_CAP=900
# GROQ_DAILY_TOKEN_CAP=180000
# Tokens reserved per call up front (so concurrent calls can't overshoot the token cap),
# reconciled to real usage afterwards.
# GROQ_TOKENS_PER_CALL_ESTIMATE=2000
# postgres (default) or memory (tests / local dev without the migration).
# GROQ_USAGE_STORE=postgres

# Groq request timeout in seconds (the SDK's automatic retries are disabled).
# GROQ_TIMEOUT_SECONDS=30

# Resume parsing gives up after this many seconds.
# RESUME_PARSE_TIMEOUT_SECONDS=10
