# Lens environment configuration.
# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by the backend and Alembic.
# Format: postgresql://USER[:PASSWORD]@HOST[:PORT]/DBNAME
# In production this is the Supabase Session-mode pooler string (IPv4), e.g.
# postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://user@localhost/lens

# Secret used to sign and verify JWT auth tokens (HS256).
# Generate a strong value with: openssl rand -hex 32
JWT_SECRET=

# Groq API key, used when USE_MOCK_LLM=false.
# Create one at https://console.groq.com/keys
GROQ_API_KEY=

# When true, the LLM layer returns canned mock responses (no API calls).
# Set to false to call the real Groq API.
USE_MOCK_LLM=true

# Comma-separated list of allowed browser origins for CORS.
# Local dev default is http://localhost:5173; in production set to the Vercel URL.
CORS_ORIGINS=http://localhost:5173
