# Frontend environment configuration (Vite).
# Copy to .env.local for overrides. Only VITE_-prefixed vars reach the client.

# Backend API base URL.
# Leave empty for local dev — requests fall through the Vite dev proxy (vite.config.ts)
# to http://localhost:8000. In production (Vercel) set this to the Render backend URL,
# e.g. https://lens-api.onrender.com
VITE_API_URL=
